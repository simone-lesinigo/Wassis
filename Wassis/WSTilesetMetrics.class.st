"
Metrics about the tileset
"
Class {
	#name : 'WSTilesetMetrics',
	#superclass : 'WSAbstractMetrics',
	#instVars : [
		'numberOfTiles'
	],
	#category : 'Wassis-Metrics',
	#package : 'Wassis',
	#tag : 'Metrics'
}

{ #category : 'accessing' }
WSTilesetMetrics >> numberOfTiles [

	^ numberOfTiles
]

{ #category : 'accessing' }
WSTilesetMetrics >> numberOfTiles: anObject [

	numberOfTiles := anObject
]
