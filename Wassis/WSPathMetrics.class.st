"
Metrics about the paths
"
Class {
	#name : 'WSPathMetrics',
	#superclass : 'WSMetrics',
	#instVars : [
		'totalNumberOfPaths'
	],
	#category : 'Wassis-Metrics',
	#package : 'Wassis',
	#tag : 'Metrics'
}

{ #category : 'accessing' }
WSPathMetrics >> totalNumberOfPaths [

	^ totalNumberOfPaths
]

{ #category : 'accessing' }
WSPathMetrics >> totalNumberOfPaths: anObject [

	totalNumberOfPaths := anObject
]
